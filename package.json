{
  "name": "codestrata-code-intelligence",
  "version": "0.2.0",
  "private": true,
  "description": "CPU-first, evidence-aware evolutionary code retrieval",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
